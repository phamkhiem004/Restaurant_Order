{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "restaurant-order",
  "main": "dist-worker/worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/3 * * * *", "*/5 * * * *"],
  },
  "routes": [
    {
      "pattern": "khiempg.id.vn",
      "custom_domain": true,
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_ACCOUNT_ID": "42b28ab2f9dba1c757ed380ca4fb5389",
    "REALTIMEKIT_APP_ID": "2cd985f8-e456-448b-8e36-2ec4ccaf0fd1",
    "REALTIMEKIT_GUEST_PRESET": "group_call_guest",
    "REALTIMEKIT_HOST_PRESET": "group_call_host",
  },
  "build": {
    "command": "npm run build:cloudflare",
  },
  "assets": {
    "directory": "./frontend/out",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "alias": {
    "@nestjs/websockets/socket-module": "./src/cloudflare/optional-nest-module.ts",
    "@nestjs/microservices/microservices-module": "./src/cloudflare/optional-nest-module.ts",
    "@nestjs/microservices": "./src/cloudflare/optional-nest-module.ts",
    "class-transformer/storage": "class-transformer/cjs/storage",
    "expo-sqlite": "./src/cloudflare/optional-package.ts",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-db",
      "database_id": "769e4f10-3720-4e23-8787-f0bfc2eecb9d",
      "preview_database_id": "restaurant-db-local",
      "migrations_dir": "migrations",
    },
  ],
}
