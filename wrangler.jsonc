{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "restaurant-order",
  "main": "dist-worker/worker.js",
  "compatibility_date": "2026-09-08",
  "vars": {
    "NODE_ENV": "production",
  },
  "build": {
    "command": "npm run build:worker",
  },
  "alias": {
    "@nestjs/websockets/socket-module": "./src/cloudflare/optional-nest-module.ts",
    "@nestjs/microservices/microservices-module": "./src/cloudflare/optional-nest-module.ts",
    "@nestjs/microservices": "./src/cloudflare/optional-nest-module.ts",
    "class-transformer/storage": "class-transformer/cjs/storage",
    "expo-sqlite": "./src/cloudflare/optional-package.ts",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-db",
      "database_id": "769e4f10-3720-4e23-8787-f0bfc2eecb9d",
      "preview_database_id": "restaurant-db-local",
      "migrations_dir": "migrations",
    },
  ],
}
