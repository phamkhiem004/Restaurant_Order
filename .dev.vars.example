# D1 is provided through the DB binding in wrangler.jsonc.
VNP_TMN_CODE=replace-me
VNP_HASH_SECRET=replace-me
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:8787/vnpay/vnpay-return

# Create a Cloudflare API token with Realtime permissions.
REALTIMEKIT_API_TOKEN=replace-me
REALTIMEKIT_DEMO_KEY=replace-with-a-random-secret

# Redis-compatible REST API. Upstash REST works in Cloudflare Workers.
UPSTASH_REDIS_REST_URL=https://replace-me.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
