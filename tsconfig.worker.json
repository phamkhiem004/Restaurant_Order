{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist-worker",
    "declaration": false,
    "incremental": false,
    "types": ["node", "@cloudflare/workers-types"]
  },
  "exclude": [
    "node_modules",
    "frontend",
    "test",
    "dist",
    "dist-worker",
    "**/*spec.ts"
  ]
}
